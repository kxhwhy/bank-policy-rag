# 复制为 .env 后填入实际值。.env 已在 .gitignore 中，不会被提交。
#
# 这些变量的含义与默认值见 core/config.py。
# 不配的话服务仍能启动，但会降级：没有 LLM key 时答案退化为条款原文直读。

# ---------- MySQL ----------
POLICY_MYSQL_HOST=127.0.0.1
POLICY_MYSQL_PORT=3306
POLICY_MYSQL_USER=root
POLICY_MYSQL_PASSWORD=你的MySQL密码
POLICY_MYSQL_DATABASE=bank_policy

# ---------- Redis ----------
POLICY_REDIS_HOST=127.0.0.1
POLICY_REDIS_PORT=6379
POLICY_REDIS_PASSWORD=你的Redis密码

# ---------- Milvus ----------
POLICY_MILVUS_URI=http://127.0.0.1:19530
POLICY_MILVUS_DB=bank_policy

# ---------- LLM（必填，否则降级为条款直读）----------
POLICY_LLM_API_KEY=
POLICY_LLM_BASE_URL=https://api.deepseek.com/v1
POLICY_LLM_MODEL=deepseek-chat

# ---------- 模型路径 ----------
# 默认会去 models/ 下按目录名找；用 Docker 时由 compose 覆盖为 /app/models/...
# POLICY_EMBEDDING_MODEL=BAAI/bge-m3
# POLICY_RERANK_MODEL_PATH=models/bge-reranker-large
